scalar DateTime
scalar Date

type Query {
    """
    WORKED EXAMPLE. Returns every property. Use this as your reference:
    schema -> resolver (PropertyGraphqlController) -> repository -> React component.
    """
    properties: [Property!]!

    """
    Arrivals at one property for a single calendar day, ordered by arrival time.

    "Today" is the property's local day (property.timezone), not the server's or
    the browser's. `date` defaults to today in that zone; pass one to look at
    another day. Cancelled and no-show reservations are not listed.

    Errors with NOT_FOUND if the property does not exist, rather than returning
    an empty list that would be indistinguishable from a quiet day.
    """
    arrivals(propertyId: ID!, date: Date): [Arrival!]!
}

type Property {
    id: ID!
    code: String!
    name: String!
    timezone: String!
}

type Unit {
    id: ID!
    label: String!
    floor: Int
}

enum ReservationStatus {
    CONFIRMED
    IN_HOUSE
    CHECKED_OUT
    CANCELLED
    NO_SHOW
}

type Arrival {
    reservationId: ID!
    guestName: String!
    "Instant of arrival (RFC 3339, with offset). Render it in the property's zone."
    arrival: DateTime!
    status: ReservationStatus!
    "Null when no unit has been assigned yet."
    unit: Unit
}
