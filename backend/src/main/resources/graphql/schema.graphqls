scalar DateTime

type Query {
    """
    WORKED EXAMPLE. Returns every property. Use this as your reference:
    schema -> resolver (PropertyGraphqlController) -> repository -> React component.
    """
    properties: [Property!]!

    # =====================================================================
    # YOUR TASK: add a query returning today's arrivals for one property.
    # The shape is up to you. Design it as you would for a real backoffice.
    # =====================================================================
    arrivals(propertyId: ID!): [Arrival!]!
}

type Property {
    id: ID!
    code: String!
    name: String!
    timezone: String!
}

type Unit {
    id: ID!
    label: String!
    floor: Int
}

enum ReservationStatus {
    CONFIRMED
    IN_HOUSE
    CHECKED_OUT
    CANCELLED
    NO_SHOW
}

type Arrival {
    reservationId: ID!
    guestName: String!
    arrival: DateTime!
    status: ReservationStatus!
    unit: Unit
}
